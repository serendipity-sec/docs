* text=auto

# 한글/오피스 문서는 바이너리로 취급 (줄바꿈 변환 금지, diff 시도 금지)
*.hwp   binary
*.hwpx  binary
*.docx  binary
*.pptx  binary
*.xlsx  binary
*.pdf   binary
*.png   binary
*.jpg   binary
